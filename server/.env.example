# Render Web Service Environment Variables
PORT=5001
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace with your actual credentials from MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nxtwave?retryWrites=true&w=majority

# Vercel Frontend Domain for CORS
CLIENT_URL=https://your-app-name.vercel.app

# Admin Authentication Secret (to protect /api/admin/registrations)
ADMIN_SECRET_KEY=nxtwave-admin-2025
